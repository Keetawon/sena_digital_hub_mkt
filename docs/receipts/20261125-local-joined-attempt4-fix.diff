+    def test_slice_absent_accepts_systemd255_implicit_slice_and_rejects_defined_or_active(self):
+        with tempfile.TemporaryDirectory() as folder:
+            absent_cgroup=Path(folder)/'missing.slice'
+            existing_cgroup=Path(folder)/'present.slice'
+            existing_cgroup.mkdir()
+            base={'LoadState':'loaded','ActiveState':'inactive','FragmentPath':'','DropInPaths':''}
+            self.assertTrue(runtime_control.slice_absent('sena-hub-test.slice',base,cgroup=absent_cgroup))
+            self.assertTrue(runtime_control.slice_absent('sena-hub-test.slice',{'LoadState':'not-found'},cgroup=existing_cgroup))
+            for bad in (
+                {**base,'FragmentPath':'/etc/systemd/system/sena-hub-test.slice'},
+                {**base,'DropInPaths':'/etc/systemd/system/sena-hub-test.slice.d/90.conf'},
+                {**base,'ActiveState':'active'},
+            ):
+                self.assertFalse(runtime_control.slice_absent('sena-hub-test.slice',bad,cgroup=absent_cgroup))
+            self.assertFalse(runtime_control.slice_absent('sena-hub-test.slice',base,cgroup=existing_cgroup))
+            self.assertFalse(runtime_control.slice_absent('sena-hub-test-api.service',base,cgroup=absent_cgroup))
+
